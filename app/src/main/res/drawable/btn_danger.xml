<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#7E211A" android:endColor="#5E1812" />
            <corners android:radius="20dp" />
            <stroke android:width="3dp" android:color="#4A120D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#B3362B" android:endColor="#7E211A" />
            <corners android:radius="20dp" />
            <stroke android:width="3dp" android:color="#4A120D" />
        </shape>
    </item>
</selector>
