<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_persepolis"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="72dp" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="56sp"
            android:textColor="@color/gold"
            android:shadowColor="#AA6B4A08"
            android:shadowDy="5"
            android:shadowRadius="14" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/menu_subtitle"
            android:textSize="18sp"
            android:textColor="@color/gold_pale" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1.12" />

        <!-- خورشید چرخان بالای دکمه شروع بازی:
             امواج نور بیرونی ساعتگرد، دایره مرکزی پادساعتگرد -->
        <FrameLayout
            android:id="@+id/sunView"
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/sunRays"
                android:layout_width="196dp"
                android:layout_height="196dp"
                android:layout_gravity="center"
                android:src="@drawable/sun_rays"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/sunCore"
                android:layout_width="126dp"
                android:layout_height="126dp"
                android:layout_gravity="center"
                android:src="@drawable/sun_core"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="270dp"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/btn_gold"
            android:text="@string/btn_start"
            android:textSize="25sp"
            android:textColor="@color/lapis_deep"
            android:elevation="5dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnShop"
            android:layout_width="270dp"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_lapis"
            android:text="@string/btn_shop"
            android:textSize="23sp"
            android:textColor="@color/gold_pale"
            android:elevation="4dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="270dp"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_danger"
            android:text="@string/btn_exit"
            android:textSize="21sp"
            android:textColor="@color/white"
            android:elevation="4dp"
            android:stateListAnimator="@null" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/statsBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="18dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/panel_lapis">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/coin"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="24sp"
                    android:textColor="@color/gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/coins_label"
                    android:textSize="17sp"
                    android:textColor="@color/gold_pale" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvWins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <Space
                    android:layout_width="26dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/tvLosses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- دکمه قطع/وصل صدای بازی — بالا سمت چپ صفحه -->
    <FrameLayout
        android:id="@+id/btnSound"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="top|left"
        android:layout_marginTop="18dp"
        android:layout_marginLeft="18dp"
        android:background="@drawable/btn_round"
        android:clipChildren="false"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/imgSound"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_sound_on"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- دکمه درباره ما — بالا سمت راست صفحه -->
    <FrameLayout
        android:id="@+id/btnAbout"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="18dp"
        android:layout_marginRight="18dp"
        android:background="@drawable/btn_round"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/imgAbout"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_about"
            android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
