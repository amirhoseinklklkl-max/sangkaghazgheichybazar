<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_persepolis"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="7dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/panel_lapis"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/shop_title"
                android:textSize="21sp"
                android:textColor="@color/gold_pale" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- باکس موجودی سکه کاربر در فروشگاه -->
            <LinearLayout
                android:id="@+id/coinChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:background="@drawable/panel_lapis">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/coin"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvShopCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="20sp"
                    android:textColor="@color/gold" />
            </LinearLayout>
        </LinearLayout>

        <!-- tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <Button
                android:id="@+id/tabHands"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/btn_gold"
                android:text="@string/tab_hands"
                android:textSize="17sp"
                android:textColor="@color/lapis_deep"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabBackgrounds"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_lapis"
                android:text="@string/tab_backgrounds"
                android:textSize="17sp"
                android:textColor="@color/gold_pale"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabMarket"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_lapis"
                android:text="@string/tab_market"
                android:textSize="17sp"
                android:textColor="@color/gold_pale"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ===== hands tab ===== -->
            <LinearLayout
                android:id="@+id/handsTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/triangleRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingTop="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="9dp"
                        android:src="@drawable/triangle"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="9dp"
                        android:src="@drawable/triangle"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="9dp"
                        android:src="@drawable/triangle"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="9dp"
                        android:src="@drawable/triangle"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="9dp"
                        android:src="@drawable/triangle"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/skinsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/skinsRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp" />
                </HorizontalScrollView>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivDown"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/ic_down"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/previewHand"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:layout_marginTop="2dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvTreasure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="20sp"
                        android:textColor="@color/gold_pale" />

                    <Button
                        android:id="@+id/btnWear"
                        android:layout_width="235dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/btn_gold"
                        android:textSize="21sp"
                        android:textColor="@color/lapis_deep"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <!-- مثلث‌های رو به بالا در پایین بخش اسکرول (آینه ردیف بالا) -->
                <LinearLayout
                    android:id="@+id/triangleRowBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="9dp"
                        android:src="@drawable/triangle_up"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="9dp"
                        android:src="@drawable/triangle_up"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="9dp"
                        android:src="@drawable/triangle_up"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="9dp"
                        android:src="@drawable/triangle_up"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="9dp"
                        android:src="@drawable/triangle_up"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== backgrounds tab ===== -->
            <LinearLayout
                android:id="@+id/bgsTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/bgsRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/panel_lapis"
                        android:padding="7dp">

                        <ImageView
                            android:id="@+id/previewBg"
                            android:layout_width="220dp"
                            android:layout_height="300dp"
                            android:scaleType="centerCrop"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvTreasureBg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="20sp"
                        android:textColor="@color/gold_pale" />

                    <Button
                        android:id="@+id/btnWearBg"
                        android:layout_width="235dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/btn_gold"
                        android:textSize="21sp"
                        android:textColor="@color/lapis_deep"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== black market tab ===== -->
            <ScrollView
                android:id="@+id/marketTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/marketCol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp" />
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- reward (clapper) floating button -->
    <LinearLayout
        android:id="@+id/btnReward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:background="@drawable/panel_lapis">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_clapper"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/reward_label"
            android:textSize="15sp"
            android:textColor="@color/gold" />
    </LinearLayout>
</FrameLayout>
